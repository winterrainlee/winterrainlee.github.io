---
import type { CollectionEntry } from 'astro:content';
import TagLink from './TagLink.astro';
import { entrySlug, formatDate, postPath, timelineDate, type Section } from '../lib/content';

interface Props {
  posts: Array<CollectionEntry<Section> & { section?: Section }>;
  section: Section;
}

const { posts, section } = Astro.props;
---

<div class="grid gap-4">
  {posts.map((post) => (
    <article class="rounded-lg border border-[var(--line)] bg-white/45 p-4 transition hover:-translate-y-0.5 hover:border-[var(--accent)]">
      <div class="text-xs uppercase tracking-[0.16em] text-[var(--muted)]">{formatDate(timelineDate(post))}</div>
      <h2 class="serif mt-2 text-2xl">
        <a href={postPath(section, entrySlug(post))} class="no-underline transition hover:text-[var(--accent)]">{post.data.title}</a>
      </h2>
      {post.data.description && <p class="mt-2 text-sm leading-relaxed text-[var(--muted)]">{post.data.description}</p>}
      {post.data.tags.length > 0 && (
        <div class="mt-3 flex flex-wrap gap-2">
          {post.data.tags.map((tag) => <TagLink tag={tag} />)}
        </div>
      )}
    </article>
  ))}
</div>
