---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import TagLink from '../components/TagLink.astro';
import BaseLayout from './BaseLayout.astro';
import { formatDate, formatDateTime, postFooterDate } from '../lib/content';

interface Props {
  post: CollectionEntry<'memo'> | CollectionEntry<'articles'> | CollectionEntry<'self-practice'>;
}

const { post } = Astro.props;
const { Content } = await render(post);
const description = post.data.description ?? post.data.title;
const footer = postFooterDate(post);
---

<BaseLayout title={`${post.data.title} | 겨울비`} description={description}>
  <article>
    <header class="mb-9">
      <p class="mb-3 text-sm text-[var(--muted)]">{formatDate(post.data.date)}</p>
      <h1 class="serif m-0 text-4xl leading-tight">{post.data.title}</h1>
      {post.data.description && <p class="mt-4 text-lg leading-relaxed text-[var(--muted)]">{post.data.description}</p>}
      {post.data.tags.length > 0 && (
        <div class="mt-4 flex flex-wrap gap-2">
          {post.data.tags.map((tag) => <TagLink tag={tag} class="py-1" />)}
        </div>
      )}
    </header>
    <div class="prose">
      <Content />
    </div>
    <footer class="mt-12 border-t border-[var(--line)] pt-4 text-sm text-[var(--muted)]">
      <time datetime={footer.date.toISOString()}>{footer.label}: {formatDateTime(footer.date)}</time>
    </footer>
  </article>
</BaseLayout>

<style is:global>
  .prose img[src*="/assets/pi-finance-observer/"] {
    display: block;
    width: 100% !important;
    max-width: 100% !important;
    height: auto !important;
    margin-inline: auto;
  }

  .prose figure:has(> img[src*="/assets/pi-finance-observer/"]) {
    overflow-x: hidden !important;
  }

  @media (max-width: 720px) {
    .prose figure:has(> img[src*="/assets/pi-finance-observer/"]) {
      margin-block: 1.5rem !important;
      padding: 0.75rem !important;
    }
  }
</style>

<script>
  const media = window.matchMedia('(max-width: 720px)');
  const diagrams = Array.from(document.querySelectorAll('img[src*="/assets/pi-finance-observer/"]'));

  const syncPiFinanceDiagrams = () => {
    diagrams.forEach((image) => {
      const img = image;
      const current = img.getAttribute('src');
      if (!current) return;

      const desktop = img.dataset.desktopSrc ?? current.replace('-mobile.svg', '.svg');
      img.dataset.desktopSrc = desktop;
      const mobile = desktop.replace(/\.svg$/, '-mobile.svg');
      const next = media.matches ? mobile : desktop;

      if (img.getAttribute('src') !== next) img.setAttribute('src', next);
    });
  };

  syncPiFinanceDiagrams();
  media.addEventListener('change', syncPiFinanceDiagrams);
</script>
