---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import PostLayout from '../../layouts/PostLayout.astro';
import { entrySlug, type Section } from '../../lib/content';

type AnyPost = CollectionEntry<'memo'> | CollectionEntry<'articles'>;

export async function getStaticPaths() {
  const sections: Section[] = ['memo', 'articles'];
  const groups = await Promise.all(
    sections.map(async (section) => {
      const posts = await getCollection(section, ({ data }) => !data.draft);
      return posts.map((post) => ({
        params: { section, slug: entrySlug(post) },
        props: { post },
      }));
    }),
  );

  return groups.flat();
}

const { post } = Astro.props as { post: AnyPost };
---

<PostLayout post={post} />
