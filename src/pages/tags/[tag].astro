---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TagLink from '../../components/TagLink.astro';
import {
  entrySlug,
  formatDate,
  getAllPublished,
  getTagGroups,
  postPath,
  readingMinutes,
  sectionLabels,
  timelineDate,
  type TagGroup,
} from '../../lib/content';

export async function getStaticPaths() {
  const posts = await getAllPublished();
  return getTagGroups(posts).map((group) => ({
    params: { tag: group.slug },
    props: { group },
  }));
}

const { group } = Astro.props as { group: TagGroup };
const title = `#${group.tag} | 겨울비`;
const description = `${group.tag} 태그 글 ${group.posts.length}개`;
---

<BaseLayout title={title} description={description}>
  <header class="mb-10">
    <p class="mb-3 text-xs font-bold uppercase tracking-[0.16em] text-[var(--accent-2)]">Tag</p>
    <h1 class="serif text-4xl">#{group.tag}</h1>
    <p class="mt-3 text-sm text-[var(--muted)]">{group.posts.length} posts</p>
  </header>

  <div class="grid gap-4">
    {group.posts.map((post) => (
      <article class="rounded-lg border border-[var(--line)] bg-white/45 p-4 transition hover:border-[var(--accent)]">
        <div class="flex flex-wrap items-center gap-2 text-xs uppercase tracking-[0.14em] text-[var(--muted)]">
          <span>{sectionLabels[post.section]}</span>
          <span>{formatDate(timelineDate(post))}</span>
          <span>{readingMinutes(post)} min read</span>
        </div>
        <h2 class="serif mt-2 text-2xl leading-tight">
          <a href={postPath(post.section, entrySlug(post))} class="no-underline transition hover:text-[var(--accent)]">{post.data.title}</a>
        </h2>
        {post.data.description && <p class="mt-2 text-sm leading-relaxed text-[var(--muted)]">{post.data.description}</p>}
        {post.data.tags.length > 0 && (
          <div class="mt-3 flex flex-wrap gap-2">
            {post.data.tags.map((tag) => <TagLink tag={tag} />)}
          </div>
        )}
      </article>
    ))}
  </div>
</BaseLayout>
