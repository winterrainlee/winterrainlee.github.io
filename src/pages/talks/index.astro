---
import PostList from '../../components/PostList.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublished } from '../../lib/content';

const posts = await getPublished('talks');
---

<BaseLayout title="Talks | winterrainlee" description="Talks and sessions">
  <h1 class="serif mb-6 text-4xl">Talks</h1>
  <PostList posts={posts} section="talks" />
</BaseLayout>
