---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TagLink from '../../components/TagLink.astro';
import { entrySlug, formatDate, getAllPublished, getSiteIntroductions, postPath, readingMinutes, sectionLabels, timelineDate } from '../../lib/content';

const introductions = await getSiteIntroductions();
const posts = await getAllPublished();
const years = posts.reduce<Record<string, typeof posts>>((groups, post) => {
  const year = String(timelineDate(post).getFullYear());
  groups[year] ??= [];
  groups[year].push(post);
  return groups;
}, {});
---

<BaseLayout title="Timeline | 겨울비" description={introductions.timeline.description}>
  <header class="mb-10">
    <h1 class="serif text-4xl">Timeline</h1>
    <p class="mt-3 leading-relaxed text-[var(--muted)]">
      {introductions.timeline.intro}
    </p>
  </header>

  <div class="timeline-rail grid gap-10">
    {Object.entries(years).map(([year, items]) => (
      <section class="grid gap-4">
        <h2 class="serif text-3xl md:pl-36">{year}</h2>
        <div class="grid gap-5">
          {items.map((post) => (
            <article class="grid gap-3 rounded-lg border border-[var(--line)] bg-white/45 p-4 transition hover:border-[var(--accent)] md:grid-cols-[7rem_1fr]">
              <div class="relative pl-6 text-sm text-[var(--muted)] md:pl-0">
                <span class="absolute left-0 top-1.5 h-3 w-3 rounded-full border border-[var(--accent)] bg-[var(--paper)] md:left-[6.9rem]"></span>
                <div>{formatDate(timelineDate(post))}</div>
                <div class="mt-1">{readingMinutes(post)} min read</div>
              </div>
              <div class="md:pl-6">
                <div class="flex flex-wrap items-center gap-2 text-xs uppercase tracking-[0.14em] text-[var(--muted)]">
                  <span>{sectionLabels[post.section]}</span>
                  {post.data.tags.map((tag) => <TagLink tag={tag} class="normal-case tracking-normal" />)}
                </div>
                <h3 class="serif mt-2 text-2xl leading-tight">
                  <a href={postPath(post.section, entrySlug(post))} class="no-underline transition hover:text-[var(--accent)]">{post.data.title}</a>
                </h3>
                {post.data.description && <p class="mt-2 text-sm leading-relaxed text-[var(--muted)]">{post.data.description}</p>}
              </div>
            </article>
          ))}
        </div>
      </section>
    ))}
  </div>
</BaseLayout>
