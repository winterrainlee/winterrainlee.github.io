---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate } from '../../lib/content';

const items = (await getCollection('timeline')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="Timeline | winterrainlee" description="Activity timeline">
  <h1 class="serif mb-8 text-4xl">Timeline</h1>
  <div class="grid gap-4">
    {items.map((item) => (
      <article class="border-l-2 border-[var(--line)] pl-4">
        <p class="text-sm text-[var(--muted)]">{formatDate(item.data.date)}</p>
        <h2 class="serif mt-1 text-2xl">
          {item.data.link ? <a href={item.data.link}>{item.data.title}</a> : item.data.title}
        </h2>
        {item.data.description && <p class="mt-2 text-[var(--muted)]">{item.data.description}</p>}
      </article>
    ))}
  </div>
</BaseLayout>
