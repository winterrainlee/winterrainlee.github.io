---
import PostList from '../../components/PostList.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublished } from '../../lib/content';

const posts = await getPublished('bookshelf');
---

<BaseLayout title="Bookshelf | winterrainlee" description="Books and reading notes">
  <h1 class="serif mb-6 text-4xl">Bookshelf</h1>
  <PostList posts={posts} section="bookshelf" />
</BaseLayout>
