---
import PostList from '../../components/PostList.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublished } from '../../lib/content';

const posts = await getPublished('articles');
---

<BaseLayout title="Articles | winterrainlee" description="Long-form writing">
  <h1 class="serif mb-6 text-4xl">Articles</h1>
  <PostList posts={posts} section="articles" />
</BaseLayout>
