---
import PostList from '../../components/PostList.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublished, getSiteIntroductions } from '../../lib/content';

const introductions = await getSiteIntroductions();
const posts = await getPublished('articles');
---

<BaseLayout title="Articles | 겨울비" description={introductions.articles.description}>
  <h1 class="serif mb-6 text-4xl">Article</h1>
  <p class="mb-8 text-[var(--muted)]">{introductions.articles.intro}</p>
  <PostList posts={posts} section="articles" />
</BaseLayout>
