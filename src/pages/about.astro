---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const about = await getEntry('pages', 'about');

if (!about) {
  throw new Error('Missing about page content.');
}

const { Content } = await render(about);
---

<BaseLayout title={`${about.data.title} | 겨울비`} description={about.data.description}>
  <article class="prose">
    <Content />
  </article>
</BaseLayout>
