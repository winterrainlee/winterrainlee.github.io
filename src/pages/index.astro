---
import BaseLayout from '../layouts/BaseLayout.astro';
import { entrySlug, formatDate, getAllPublished, getPublished, postPath } from '../lib/content';

const allPosts = await getAllPublished();
const latest = allPosts[0];
const sidePosts = allPosts.slice(1, 3);
const moreArticles = (await getPublished('articles')).slice(0, 3);
const thoughts = (await getPublished('thoughts')).slice(0, 5);
const books = (await getPublished('bookshelf')).slice(0, 6);
---

<BaseLayout>
  <section class="mb-10 text-center">
    <div class="mx-auto grid h-24 w-24 place-items-center rounded-full border border-[var(--line)] bg-[var(--soft)] serif text-4xl">W</div>
    <h1 class="serif mt-4 text-3xl">winterrainlee</h1>
    <p class="mt-2 text-[var(--muted)]">Notes on software, books, and days worth keeping.</p>
  </section>

  {latest && (
    <section class="grid gap-4 md:grid-cols-[1.35fr_0.85fr]">
      <a href={postPath(latest.section, entrySlug(latest))} class="rounded-lg border border-[var(--line)] bg-white/55 p-5 no-underline transition hover:border-[var(--accent)]">
        <div class="text-xs font-bold uppercase tracking-[0.16em] text-[var(--accent-2)]">Latest</div>
        <h2 class="serif mt-3 text-3xl leading-tight">{latest.data.title}</h2>
        {latest.data.description && <p class="mt-4 leading-relaxed text-[var(--muted)]">{latest.data.description}</p>}
        <p class="mt-5 text-sm text-[var(--muted)]">{formatDate(latest.data.date)}</p>
      </a>
      <div class="grid gap-4">
        {sidePosts.map((post) => (
          <a href={postPath(post.section, entrySlug(post))} class="rounded-lg border border-[var(--line)] bg-white/45 p-4 no-underline transition hover:border-[var(--accent)]">
            <h3 class="serif text-xl">{post.data.title}</h3>
            <p class="mt-3 text-sm text-[var(--muted)]">{formatDate(post.data.date)}</p>
          </a>
        ))}
      </div>
    </section>
  )}

  <section class="mt-12">
    <div class="mb-4 flex items-center justify-between">
      <h2 class="text-xs font-bold uppercase tracking-[0.16em] text-[var(--muted)]">More Articles</h2>
      <a href="/articles/" class="text-sm no-underline">All articles</a>
    </div>
    <div class="grid gap-4 md:grid-cols-3">
      {moreArticles.map((post) => (
        <a href={postPath('articles', entrySlug(post))} class="rounded-lg border border-[var(--line)] bg-white/45 p-4 no-underline transition hover:border-[var(--accent)]">
          <h3 class="serif text-xl">{post.data.title}</h3>
          <p class="mt-3 text-sm text-[var(--muted)]">{formatDate(post.data.date)}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="mt-12 grid gap-10 md:grid-cols-2">
    <div>
      <div class="mb-4 flex items-center justify-between">
        <h2 class="text-xs font-bold uppercase tracking-[0.16em] text-[var(--muted)]">Thoughts</h2>
        <a href="/thought/" class="text-sm no-underline">All thoughts</a>
      </div>
      <div class="grid gap-2">
        {thoughts.map((post) => (
          <a href={postPath('thoughts', entrySlug(post))} class="flex gap-3 border-b border-[var(--line)] py-2 text-sm no-underline">
            <span class="w-24 shrink-0 text-[var(--muted)]">{formatDate(post.data.date)}</span>
            <span>{post.data.title}</span>
          </a>
        ))}
      </div>
    </div>
    <div>
      <div class="mb-4 flex items-center justify-between">
        <h2 class="text-xs font-bold uppercase tracking-[0.16em] text-[var(--muted)]">Bookshelf</h2>
        <a href="/bookshelf/" class="text-sm no-underline">All books</a>
      </div>
      <div class="grid grid-cols-2 gap-3">
        {books.map((post) => (
          <a href={postPath('bookshelf', entrySlug(post))} class="rounded-lg border border-[var(--line)] bg-white/45 p-3 no-underline transition hover:border-[var(--accent)]">
            <h3 class="serif text-lg leading-snug">{post.data.title}</h3>
            <p class="mt-2 text-xs text-[var(--muted)]">{formatDate(post.data.date)}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
