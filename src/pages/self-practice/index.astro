---
import PostList from '../../components/PostList.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublished, getSiteIntroductions } from '../../lib/content';

const introductions = await getSiteIntroductions();
const posts = await getPublished('self-practice');
---

<BaseLayout title="Self-Practice | 겨울비" description={introductions.selfPractice.description}>
  <h1 class="serif mb-6 text-4xl">Self-Practice</h1>
  <p class="mb-8 text-[var(--muted)]">{introductions.selfPractice.intro}</p>
  <PostList posts={posts} section="self-practice" />
</BaseLayout>
