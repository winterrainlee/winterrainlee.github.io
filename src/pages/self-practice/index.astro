---
import PostList from '../../components/PostList.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublished } from '../../lib/content';

const posts = await getPublished('self-practice');
---

<BaseLayout title="Self-Practice | 겨울비" description="이것저것 연습하며 남긴 기록">
  <h1 class="serif mb-6 text-4xl">Self-Practice</h1>
  <p class="mb-8 text-[var(--muted)]">
    AI agent, automation, 이 블로그처럼 직접 만져보고 연습하며 배운 것들을 정리합니다.
  </p>
  <PostList posts={posts} section="self-practice" />
</BaseLayout>
